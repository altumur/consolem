{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setup-ui.schema.json",
  "title": "Сообщения протокола setup/1",
  "description": "Сообщения postMessage между consolem и своей страницей подсистемы (setupUi.mode: iframe). Описание — api/SETUP-UI.md. Получатель пропускает незнакомый type и незнакомое поле",
  "oneOf": [
    {
      "$ref": "#/$defs/init"
    },
    {
      "$ref": "#/$defs/draft"
    },
    {
      "$ref": "#/$defs/applied"
    },
    {
      "$ref": "#/$defs/errors"
    },
    {
      "$ref": "#/$defs/revert"
    },
    {
      "$ref": "#/$defs/theme"
    },
    {
      "$ref": "#/$defs/flush"
    },
    {
      "$ref": "#/$defs/ready"
    },
    {
      "$ref": "#/$defs/change"
    },
    {
      "$ref": "#/$defs/invalid"
    },
    {
      "$ref": "#/$defs/height"
    },
    {
      "$ref": "#/$defs/flushed"
    },
    {
      "$ref": "#/$defs/call"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/subscribe"
    },
    {
      "$ref": "#/$defs/unsubscribe"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/navigate"
    },
    {
      "$ref": "#/$defs/confirm"
    }
  ],
  "$defs": {
    "init": {
      "type": "object",
      "description": "Первое сообщение consolem после ready: объект, черновик, тема, язык и что умеет consolem",
      "x-direction": "toPage",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "uid",
        "kind",
        "lang",
        "theme",
        "readOnly",
        "unit",
        "draft",
        "host"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "init"
          ]
        },
        "uid": {
          "type": "string",
          "description": "uid объекта"
        },
        "kind": {
          "type": "string",
          "description": "Код вида объекта"
        },
        "lang": {
          "type": "string",
          "description": "Язык интерфейса: ru, en…"
        },
        "theme": {
          "$ref": "#/$defs/themeSpec"
        },
        "readOnly": {
          "type": "boolean",
          "description": "true — у человека право view без edit: страница не принимает ввод, consolem не принимает change"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "draft": {
          "$ref": "#/$defs/mergePatch"
        },
        "host": {
          "$ref": "#/$defs/host"
        }
      }
    },
    "draft": {
      "type": "object",
      "description": "Черновик изменили вне страницы, например в «Все параметры»",
      "x-direction": "toPage",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "patch"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "draft"
          ]
        },
        "patch": {
          "$ref": "#/$defs/mergePatch"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bridgeStep"
          },
          "description": "Шаг 2, необязательно: шаги моста в черновике"
        }
      }
    },
    "applied": {
      "type": "object",
      "description": "«Применить» прошло: новый объект, черновик пуст. На шаге 2 — и итог шагов моста",
      "x-direction": "toPage",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "unit"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "applied"
          ]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bridgeStepResult"
          },
          "description": "Шаг 2, необязательно: итог шагов моста"
        }
      }
    },
    "errors": {
      "type": "object",
      "description": "Бэкенд отверг правку в POST /units/validate: Problem как есть. Отказ POST /operations странице не приходит",
      "x-direction": "toPage",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "problem"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "errors"
          ]
        },
        "problem": {
          "$ref": "#/$defs/problem"
        }
      }
    },
    "revert": {
      "type": "object",
      "description": "Объект у бэкенда изменился или черновик опустел по действию consolem: страница показывает unit, черновик пуст",
      "x-direction": "toPage",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "unit"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "revert"
          ]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bridgeStep"
          },
          "description": "Шаг 2, необязательно: шаги моста в черновике — после revert список пуст"
        }
      }
    },
    "theme": {
      "type": "object",
      "description": "Тема consolem изменилась",
      "x-direction": "toPage",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "theme"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "theme"
          ]
        },
        "theme": {
          "$ref": "#/$defs/themeSpec"
        }
      }
    },
    "flush": {
      "type": "object",
      "description": "consolem собирается применить правку: страница отправляет последний change, затем flushed с тем же seq",
      "x-direction": "toPage",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "seq"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "flush"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Номер запроса flush; flushed повторяет его"
        }
      }
    },
    "ready": {
      "type": "object",
      "description": "Страница загрузилась и ждёт init",
      "x-direction": "toHost",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "ready"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          },
          "description": "Необязательно: указатели полей, которые показывает страница"
        }
      }
    },
    "change": {
      "type": "object",
      "description": "Правка на странице: весь черновик",
      "x-direction": "toHost",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "patch"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "change"
          ]
        },
        "patch": {
          "$ref": "#/$defs/mergePatch"
        }
      }
    },
    "invalid": {
      "type": "object",
      "description": "Страница нашла ошибку ввода. Пока список не пуст, consolem не даёт применить правку",
      "x-direction": "toHost",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "fields"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "invalid"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pointer"
          },
          "description": "Указатели полей с ошибкой; пустой список снимает запрет"
        },
        "message": {
          "type": "string",
          "description": "Необязательно: текст ошибки"
        }
      }
    },
    "height": {
      "type": "object",
      "description": "Высота содержимого страницы изменилась",
      "x-direction": "toHost",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "px"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "height"
          ]
        },
        "px": {
          "type": "integer",
          "minimum": 0,
          "description": "Высота в пикселях"
        }
      }
    },
    "flushed": {
      "type": "object",
      "description": "Ответ на flush: правка до него — последняя",
      "x-direction": "toHost",
      "x-step": 1,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "seq"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "flushed"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "Номер запроса flush; flushed повторяет его"
        }
      }
    },
    "call": {
      "type": "object",
      "description": "Шаг 2: страница просит consolem выполнить операцию контракта с x-bridge. Ответ — result с тем же id",
      "x-direction": "toHost",
      "x-step": 2,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "id",
        "op"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "call"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Номер вызова, который выбирает страница; result повторяет его"
        },
        "op": {
          "type": "string",
          "minLength": 1,
          "description": "operationId из api/openapi.json"
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "description": "Необязательно: параметры пути и запроса по именам из описания операции. consolem кодирует значение пути (encodeURIComponent)"
        },
        "body": {
          "description": "Необязательно: тело запроса по схеме операции"
        }
      }
    },
    "result": {
      "type": "object",
      "description": "Шаг 2: ответ на call, subscribe, navigate или confirm. status 0 — отказ самого моста, без запроса к серверу",
      "x-direction": "toPage",
      "x-step": 2,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "id",
        "ok",
        "status"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "result"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Номер вызова, который выбирает страница; result повторяет его"
        },
        "ok": {
          "type": "boolean",
          "description": "true — запрос удался (2xx) или шаг принят в черновик"
        },
        "status": {
          "type": "integer",
          "minimum": 0,
          "description": "HTTP-статус ответа сервера; 202 — шаг принят в черновик; 0 — отказ моста без запроса"
        },
        "body": {
          "description": "Необязательно: тело ответа сервера как есть; у шага черновика — {drafted: true, step}"
        },
        "problem": {
          "$ref": "#/$defs/problem"
        },
        "etag": {
          "type": "string",
          "description": "Необязательно: заголовок ETag ответа сервера"
        }
      }
    },
    "subscribe": {
      "type": "object",
      "description": "Шаг 2: пересылать странице события потока по объектам или видам. Ответ — result с body.sub",
      "x-direction": "toHost",
      "x-step": 2,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "id"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "subscribe"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Номер вызова, который выбирает страница; result повторяет его"
        },
        "entityIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Необязательно: uid объектов; consolem добавляет их в наблюдение потока"
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Необязательно: виды объектов"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Необязательно: типы сообщений потока (entity.changed…); нет поля — все"
        }
      }
    },
    "unsubscribe": {
      "type": "object",
      "description": "Шаг 2: снять подписку. Ответа нет",
      "x-direction": "toHost",
      "x-step": 2,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "sub"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "unsubscribe"
          ]
        },
        "sub": {
          "type": "string",
          "minLength": 1,
          "description": "Номер подписки из result.body.sub"
        }
      }
    },
    "event": {
      "type": "object",
      "description": "Шаг 2: сообщение потока по подписке страницы",
      "x-direction": "toPage",
      "x-step": 2,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "sub",
        "message"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "event"
          ]
        },
        "sub": {
          "type": "string",
          "minLength": 1,
          "description": "Номер подписки"
        },
        "message": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "description": "StreamMessage потока как есть"
        }
      }
    },
    "navigate": {
      "type": "object",
      "description": "Шаг 2: перейти к объекту в consolem. Удачный переход ответа не получает: рамка закрыта",
      "x-direction": "toHost",
      "x-step": 2,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "id",
        "uid"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "navigate"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Номер вызова, который выбирает страница; result повторяет его"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "description": "uid объекта"
        },
        "tab": {
          "type": "string",
          "description": "Необязательно: вкладка карточки"
        }
      }
    },
    "confirm": {
      "type": "object",
      "description": "Шаг 2: показать подтверждение consolem. Ответ — result с body.confirmed",
      "x-direction": "toHost",
      "x-step": 2,
      "additionalProperties": false,
      "required": [
        "proto",
        "type",
        "id",
        "title",
        "text"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "confirm"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Номер вызова, который выбирает страница; result повторяет его"
        },
        "title": {
          "type": "string",
          "description": "Заголовок; consolem показывает его текстом"
        },
        "text": {
          "type": "string",
          "description": "Текст вопроса; consolem показывает его текстом"
        },
        "lose": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Необязательно: что пропадёт"
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Необязательно: что останется"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Необязательно: число, которое человек вводит для подтверждения"
        },
        "okLabel": {
          "type": "string",
          "description": "Необязательно: подпись кнопки подтверждения"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "kind",
        "name",
        "version",
        "properties"
      ],
      "description": "Часть Unit из GET /units/{uid}: только эти поля",
      "properties": {
        "uid": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Непрозрачная строка версии"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Свойства по схеме вида"
        },
        "status": {
          "type": "object",
          "additionalProperties": true,
          "description": "Необязательно: что система видит сама"
        }
      }
    },
    "themeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "tokens"
      ],
      "description": "Тема consolem: светлая или тёмная и значения токенов оформления --one-…",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "dark",
            "light"
          ]
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Имя токена --one-… → значение CSS"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proto",
        "apply"
      ],
      "description": "Что умеет consolem: proto и apply; bridge — шаг 2 (нет поля — хост шага 1)",
      "properties": {
        "proto": {
          "type": "string",
          "enum": [
            "setup/1"
          ]
        },
        "apply": {
          "type": "string",
          "enum": [
            "button",
            "leave"
          ],
          "description": "button — человек нажимает «Применить»; leave — consolem применяет правку при уходе с карточки"
        },
        "bridge": {
          "$ref": "#/$defs/hostBridge"
        }
      }
    },
    "pointer": {
      "type": "string",
      "pattern": "^/properties/",
      "description": "JSON Pointer в Unit, как Problem.errors[].field: /properties/<имя>"
    },
    "mergePatch": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON Merge Patch (RFC 7396) к unit.properties, всегда весь черновик: null — снять значение, {} — изменений нет"
    },
    "problem": {
